DATABASE_URL=postgresql://postgres:postgres@postgres:5432/DMS
REDIS_PASSWORD=somestrongpassword
REDIS_URL=redis://:somestrongpassword@redis:6379
NODE_ENV=development
PORT=3000
REDIS_PORT=6379
REDIS_HOST=redis
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=10000
# --- Auth / JWT ---
# Use long random strings in real environments, e.g. `openssl rand -hex 32`.
# Keep the three secrets distinct so a leak of one token type can't forge another.
JWT_ACCESS_SECRET=somesupersecretkey
JWT_REFRESH_SECRET=anothersupersecretkey
JWT_MFA_SECRET=yetanothersupersecretkey
# Token lifetimes (use unit suffixes: 15m, 1h, 1d).
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=1d
JWT_MFA_EXPIRES=10m
# Cookie flags. Set COOKIE_SECURE=true when serving over HTTPS (production).
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=dms-documents
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true
STORAGE_SSE=AES256
STORAGE_SIGNED_URL_TTL=300
# --- Ledger (blockchain anchoring) ---
# Master switch for async ledger anchoring. false = uploads skip enqueue and rows
# stay PENDING_LEDGER (use when no worker/Redis is running).
LEDGER_ENABLED=true
# LedgerService implementation: memory (in-process stub) | fabric (real chaincode).
LEDGER_DRIVER=memory
LEDGER_QUEUE_NAME=ledger-anchor
# Anchor-job retry policy (BullMQ exponential backoff).
LEDGER_ANCHOR_ATTEMPTS=5
LEDGER_ANCHOR_BACKOFF_MS=5000
LEDGER_WORKER_CONCURRENCY=4
# Stub-only knob: set to "fail" to make the in-memory ledger throw on every write,
# exercising the retry -> FAILED path. Leave as "ok" for normal operation.
LEDGER_STUB_MODE=ok
# --- Fabric ledger (only used when LEDGER_DRIVER=fabric) ---
# Coordinates of the deployed `document` chaincode on the WSL2 test-network. The
# defaults below match docker-compose.dev.yml (containerize + bridge), so you
# normally only flip LEDGER_DRIVER=fabric and copy the crypto material into
# ./.fabric-crypto (DEV-ONLY, gitignored). See fabric/scripts/demo-invoke.sh and
# the FabricLedgerService in src/ledger/fabricLedger.js.
FABRIC_CHANNEL=legal-channel
FABRIC_CHAINCODE=document
FABRIC_MSP_ID=Org1MSP
# Dial the WSL peer via the Docker host gateway; the cert SAN is the alias below,
# so the gRPC TLS authority is overridden to it (hostname verification).
FABRIC_PEER_ENDPOINT=host.docker.internal:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
# Container paths to the mounted crypto (copied from the test-network's Org1 Admin
# MSP + the peer's TLS CA). DEV-ONLY — prod uses a real HSM/wallet identity.
FABRIC_SIGN_CERT=/fabric/crypto/signcert.pem
FABRIC_SIGN_KEY=/fabric/crypto/key.pem
FABRIC_TLS_ROOT_CERT=/fabric/crypto/tls-ca.crt
# --- Governance (admin-hierarchy / quorum subsystem) ---
# Master switch. false = governance service refuses to file/approve/execute.
GOVERNANCE_ENABLED=true
# sha256 hex of the founding secret. The one-time /governance/bootstrap ceremony
# is gated on sha256(providedSecret) === this value. NEVER store the secret itself.
# Compute with:  printf '%s' "$SECRET" | sha256sum
GOVERNANCE_GENESIS_COMMITMENT=
# Reserved for the deferred Tier-2 reinstatement window (hours). Core actions
# execute with no delay.
GOVERNANCE_DELAY_HOURS=72
# Objections needed to halt a PENDING proposal (fail-safe). Default 1.
GOVERNANCE_MIN_OBJECTORS=1

# --- Document-intelligence pipeline (src/jobs/documentProcessing.*) ---
# Async: upload -> ClamAV -> text extraction / Tesseract OCR -> NER -> auto-tagging
# -> store + index. Consumed by the worker; the API only reads PROCESSING_ENABLED
# to decide whether to enqueue after an upload.
PROCESSING_ENABLED=true
PROCESSING_QUEUE_NAME=document-processing
PROCESSING_ATTEMPTS=3
PROCESSING_BACKOFF_MS=5000
PROCESSING_CONCURRENCY=2
# A version left non-terminal longer than this is re-enqueued by the worker sweep.
PROCESSING_STUCK_AFTER_MS=900000
PROCESSING_RECONCILE_EVERY_MS=300000
# Largest file the pipeline will scan/extract (defaults to UPLOAD_MAX_BYTES).
PROCESSING_MAX_FILE_BYTES=52428800
# PROTOTYPE: no ClamAV/scanner deployed. The worker uses
# createRuleBasedScanner() — type/format checks only, no malware detection.
# No env vars needed for it. See src/processing/ruleBasedScanner.js.
#
# Alternative, currently unused: Cloudmersive hosted virus scan (real
# detection, but sends file bytes to a third party and caps at ~3.5MB/file —
# see src/processing/cloudmersiveScanner.js). Wire it up in src/worker.js to
# use it; these vars only take effect once you do.
CLOUDMERSIVE_API_KEY=
CLOUDMERSIVE_URL=https://api.cloudmersive.com/virus/scan/file
CLOUDMERSIVE_TIMEOUT_MS=30000
# In-process Tesseract OCR (src/processing/ocr/tesseractClient.js) — runs the
# `tesseract` + `pdftoppm` binaries in the worker container, no sidecar.
OCR_LANG=eng
OCR_TIMEOUT_MS=120000
# Lower DPI = faster/lighter OCR (worse accuracy on small print). 150 is a
# reasonable low-spec default; bump to 200-300 if scans come out garbled.
OCR_DPI=150
OCR_MAX_PAGES=50
# PDFs with fewer native-text chars per page than this are treated as scanned.
OCR_MIN_CHARS_PER_PAGE=100
# PROTOTYPE: cloud OCR fallback (api4ai) for low-confidence Tesseract results.
# Leave OCR_CLOUD_API_KEY unset to keep OCR fully local (default). Sends file
# bytes to a third party when it fires — see src/processing/ocr/cloudOcrClient.js.
OCR_CLOUD_API_KEY=
OCR_CLOUD_URL=https://api4ai.cloud/ocr/v1/results
OCR_CLOUD_TIMEOUT_MS=60000
OCR_CLOUD_CONFIDENCE_THRESHOLD=0.6
# Ordered NER providers (regex built in; spacy/llm pluggable later).
NER_PROVIDERS=regex
# Ordered auto-tagging stages.
TAGGING_PIPELINE=rules
