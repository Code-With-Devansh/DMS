# syntax=docker/dockerfile:1
FROM node:22-alpine
WORKDIR /usr/src/app
# argon2 needs build tools to compile/install its native binding on alpine.
# tesseract-ocr + poppler-utils give the worker in-process OCR
# (src/processing/ocr/tesseractClient.js) with no sidecar container.
RUN apk add --no-cache python3 make g++ tesseract-ocr tesseract-ocr-data-eng poppler-utils
COPY package.json package-lock.json ./
RUN npm ci
EXPOSE 3000
