# Env file for docker-compose.clamav.yml, on the ClamAV VM only.
# `cp env.clamav.example .env` on that VM, then `docker compose -f
# docker-compose.clamav.yml up -d`.

# This VM's own private IP inside the OCI VCN, to bind clamd to explicitly
# instead of 0.0.0.0. Leave unset only if the NSG/Security List is your sole
# access control (still recommended to set this too — defense in depth).
CLAMAV_BIND_IP=10.0.1.20
