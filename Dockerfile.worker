FROM node:22-alpine

WORKDIR /app
# argon2 needs build tools to compile/install its native binding on alpine.
# tesseract-ocr + poppler-utils replace the old PaddleOCR sidecar container:
# in-process OCR via src/processing/ocr/tesseractClient.js, a fraction of the
# image size/RAM of paddleocr+paddlepaddle+opencv. Add more
# `tesseract-ocr-data-<lang>` packages here if OCR_LANG needs more than eng.
RUN apk add --no-cache python3 make g++ tesseract-ocr tesseract-ocr-data-eng poppler-utils

COPY package*.json ./

RUN npm install

COPY . .

CMD ["node", "src/worker.js"]
